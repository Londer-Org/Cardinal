bin/
/dist/
*.test
*.out
coverage.*

# Frontend
node_modules/

# Local config and anything that could hold a credential.
# Cardinal is an identity system; a leaked dev secret is a real incident.
.env
.env.*
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key
# The end-to-end stack's break-glass key is a fixture, committed deliberately.
# It is labelled as such in examples/cardinal.e2e.toml and grants nothing
# outside that throwaway stack.
!examples/e2e-break-glass.key

.idea/
.vscode/
*.swp
.DS_Store

# Local server config; may hold a DSN. cardinal.example.toml is the template.
cardinal.toml

# Built UI is a build artifact, regenerated by `make ui`. The source lives in
# web/public and web/src; only the .gitkeep placeholder is tracked, so
# //go:embed still compiles on a fresh clone.
#
# The directory itself must NOT be listed — `web/dist/` excludes it outright,
# and git cannot re-include a file whose parent directory is excluded, so the
# negation below silently does nothing. That is how the placeholder went
# missing twice and broke the build on a clean checkout both times.
web/dist/*
!web/dist/.gitkeep
examples/.oidc-client-id

# TypeScript incremental build cache — churns on every build.
web/tsconfig.tsbuildinfo

# Python bytecode from tools/
__pycache__/

# Fixture TLS for the end-to-end ACME entrypoint, generated by make e2e-up
examples/traefik/tls/
